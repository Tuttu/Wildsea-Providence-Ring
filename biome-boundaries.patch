+/* Boundary types (set by "type" in the hexjson boundaries).
+   Regions are drawn first, biomes on top. On an edge shared by both, the dashed
+   biome line lets the region line show through the gaps.
+   Tweak the colours / widths / dash pattern here. */
+.hexmap-container {
+    --boundary-region-color: #333;
+    --boundary-region-width: 1px;
+    --boundary-biome-color: #2E8B57;
+    --boundary-biome-width: 1px;
+    --boundary-biome-dash: 8, 6;
+}
+
+.hexmap-container .lines path[data-type="region"] {
+    stroke: var(--boundary-region-color);
+    stroke-width: var(--boundary-region-width);
+}
+
+.hexmap-container .lines path[data-type="biome"] {
+    stroke: var(--boundary-biome-color);
+    stroke-width: var(--boundary-biome-width);
+    stroke-dasharray: var(--boundary-biome-dash);
+}
+
 /* Use the "ends with" selector to set default styles.
   This makes "Abundance_Dashed" dashed.
 */
