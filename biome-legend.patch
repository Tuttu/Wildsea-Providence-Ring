diff --git a/themes/wildsea/assets/css/map.css b/themes/wildsea/assets/css/map.css
index d6deb14..f5e5aa0 100644
--- a/themes/wildsea/assets/css/map.css
+++ b/themes/wildsea/assets/css/map.css
@@ -290,12 +290,15 @@
    Regions are drawn first, biomes on top. On an edge shared by both, the dashed
    biome line lets the region line show through the gaps.
    Tweak the colours / widths / dash pattern here. */
+.hexmap-wrapper,
 .hexmap-container {
     --boundary-region-color: #333;
     --boundary-region-width: 1px;
     --boundary-biome-color: #2E8B57;
     --boundary-biome-width: 1px;
     --boundary-biome-dash: 8, 6;
+    --boundary-region-highlight-color: #D9534F; /* red */
+    --boundary-biome-highlight-color: #2B7DE9;  /* blue */
 }
 
 .hexmap-container .lines path[data-type="region"] {
@@ -324,12 +327,53 @@
 /* --- Boundary Highlight Style --- */
 /* This class will be added via JavaScript on hover */
 .hexmap-container .lines path[data-type].boundary-highlight {
-    stroke: #D9534F; /* A distinct red color */
+    stroke: var(--boundary-region-highlight-color, #D9534F); /* A distinct red color */
     stroke-width: 4px;
     transition: stroke 0.2s ease-in-out, stroke-width 0.2s ease-in-out;
     z-index: 5;
 }
 
+/* Biomes are highlighted with their own colour (must come after the rule above) */
+.hexmap-container .lines path[data-type="biome"].boundary-highlight {
+    stroke: var(--boundary-biome-highlight-color, #2B7DE9);
+}
+
+/* --- Biomes in the legend --- */
+.legend-biome-group {
+    margin-top: 10px;
+    padding-top: 10px;
+    border-top: 1px solid #817B58;
+}
+.legend-group-title {
+    margin: 0 0 8px 0;
+    font-size: 12px;
+    font-weight: normal;
+    text-transform: uppercase;
+    letter-spacing: 0.05em;
+    color: #666;
+}
+.legend-biome {
+    margin: 0 0 6px 0;
+    padding: 4px 6px;
+    font-size: 16px;
+    font-weight: bold;
+    cursor: pointer;
+    border-radius: 3px;
+    transition: background-color 0.2s ease-in-out;
+}
+.legend-biome:hover {
+    background-color: #e0e0e0;
+}
+/* Small dashed swatch in the biome boundary colour */
+.legend-biome::before {
+    content: "";
+    display: inline-block;
+    width: 18px;
+    margin-right: 8px;
+    vertical-align: middle;
+    border-top: 3px dashed var(--boundary-biome-color, #2E8B57);
+}
+
 /* --- START: New Stylable Hex State Icon Styles --- */
 .icon-non-explored, .icon-non-cartographized {
     filter: grayscale(100%);
